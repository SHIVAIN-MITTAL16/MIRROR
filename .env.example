# Backend-only credentials. Copy to .env; never commit populated values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000

# PayPal sandbox only. The production/live API host is rejected by the backend.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Optional server-side product catalog access.
CHANNEL3_API_KEY=

# Local defaults. Render overrides database path, CORS origin and frontend API base.
MIRROR_DATABASE_PATH=data/mirror.sqlite3
MIRROR_CORS_ORIGINS=http://127.0.0.1:5501
MIRROR_API_BASE_URL=http://127.0.0.1:8002
