{
  "info": {
    "name": "MIRROR Purchase Assurance API",
    "description": "Buyer-first Passport APIs. All sample IDs are placeholders. PayPal example failures do not represent sandbox transactions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8002"},
    {"key": "passportId", "value": "replace-after-confirmation"},
    {"key": "conditionId", "value": "replace-with-buyer-condition-id"},
    {"key": "offerId", "value": "replace-after-offer"},
    {"key": "evidenceId", "value": "replace-after-evidence-ingestion"},
    {"key": "orderId", "value": "replace-after-order-creation"}
  ],
  "item": [
    {"name":"Health check","request":{"method":"GET","url":"{{baseUrl}}/health"},"response":[{"name":"Available","originalRequest":{"method":"GET","url":"{{baseUrl}}/health"},"status":"OK","code":200,"body":"{\"status\":\"ok\",\"service\":\"mirror\"}"}]},
    {"name":"Extract buyer intent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"text\": \"I need a new camera under 800 USD delivered in five days.\"\n}"},"url":"{{baseUrl}}/api/passport-intents/extract"},"response":[{"name":"Provider unavailable (safe error)","originalRequest":{"method":"POST","url":"{{baseUrl}}/api/passport-intents/extract"},"status":"Bad Gateway","code":502,"body":"{\"detail\":\"Gemini intent extraction failed or timed out.\"}"}]},
    {"name":"Confirm reviewed Passport","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"buyer_intent\": \"I need a new camera under 800 USD delivered in five days.\",\n  \"currency\": \"USD\",\n  \"buyer_acknowledged\": true,\n  \"conditions\": [\n    {\"condition_type\":\"price\",\"operator\":\"lte\",\"expected_value\":\"800\",\"unit\":\"USD\",\"hard_or_soft\":\"hard\",\"supporting_quote\":\"under 800 USD\"},\n    {\"condition_type\":\"delivery_days\",\"operator\":\"lte\",\"expected_value\":\"5\",\"unit\":\"days\",\"hard_or_soft\":\"hard\",\"supporting_quote\":\"in five days\"}\n  ]\n}"},"url":"{{baseUrl}}/api/passports/confirm-intent"},"response":[{"name":"Invalid quote","originalRequest":{"method":"POST","url":"{{baseUrl}}/api/passports/confirm-intent"},"status":"Unprocessable Entity","code":422,"body":"{\"detail\":[{\"msg\":\"supporting_quote must be an exact substring of buyer_intent\"}]}"}]},
    {"name":"List Passports","request":{"method":"GET","url":"{{baseUrl}}/api/passports"}},
    {"name":"Retrieve Passport","request":{"method":"GET","url":"{{baseUrl}}/api/passports/{{passportId}}"}},
    {"name":"Create seller offer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"product_name\": \"Camera model as offered\",\n  \"seller_name\": \"Seller-declared name\",\n  \"displayed_price\": 750,\n  \"currency\": \"USD\",\n  \"conditions\": [{\n    \"condition_id\": \"{{conditionId}}\",\n    \"seller_confirms\": true,\n    \"seller_value\": \"750\",\n    \"evidence_content\": \"Seller statement preserved as raw, unverified text.\"\n  }]\n}"},"url":"{{baseUrl}}/api/passports/{{passportId}}/offers"}},
    {"name":"Retrieve seller offers","request":{"method":"GET","url":"{{baseUrl}}/api/passports/{{passportId}}/offers"}},
    {"name":"Ingest evidence","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"content\": \"Seller statement copied for preservation; not independently verified.\",\n  \"content_type\": \"text/plain\",\n  \"condition_ids\": [\"{{conditionId}}\"],\n  \"claimed_source_name\": \"Seller-declared source\"\n}"},"url":"{{baseUrl}}/api/passports/{{passportId}}/evidence"}},
    {"name":"Retrieve evidence","request":{"method":"GET","url":"{{baseUrl}}/api/passports/{{passportId}}/evidence/{{evidenceId}}"}},
    {"name":"Evaluate selected offer","request":{"method":"POST","url":{"raw":"{{baseUrl}}/api/passports/{{passportId}}/evaluate?offer_id={{offerId}}","host":["{{baseUrl}}"],"path":["api","passports","{{passportId}}","evaluate"],"query":[{"key":"offer_id","value":"{{offerId}}"}]}}},
    {"name":"PayPal configuration","request":{"method":"GET","url":"{{baseUrl}}/api/paypal/config"},"response":[{"name":"Checkout unconfigured","originalRequest":{"method":"GET","url":"{{baseUrl}}/api/paypal/config"},"status":"OK","code":200,"body":"{\"configured\":false,\"client_id\":null,\"mode\":\"sandbox\",\"missing\":[\"PAYPAL_CLIENT_ID\",\"PAYPAL_CLIENT_SECRET\",\"PAYPAL_BASE_URL\"],\"webhook_configured\":false}"}]},
    {"name":"Create PayPal order (requires APPROVE)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"offer_id\":\"{{offerId}}\"}"},"url":"{{baseUrl}}/api/passports/{{passportId}}/paypal/order"},"response":[{"name":"Blocked when not approved","originalRequest":{"method":"POST","url":"{{baseUrl}}/api/passports/{{passportId}}/paypal/order"},"status":"Conflict","code":409,"body":"{\"detail\":{\"message\":\"Checkout is blocked unless the persisted Passport decision is APPROVE.\",\"outcome\":\"ESCALATE\",\"reasons\":[\"Required information is unresolved.\"]}}"}]},
    {"name":"Capture PayPal order (server verifies approval and capture)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"order_id\":\"{{orderId}}\"}"},"url":"{{baseUrl}}/api/passports/{{passportId}}/paypal/capture"}},
    {"name":"Cancel PayPal order","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"order_id\":\"{{orderId}}\"}"},"url":"{{baseUrl}}/api/passports/{{passportId}}/paypal/cancel"}},
    {"name":"Verify PayPal webhook (signature headers required)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"PAYPAL-AUTH-ALGO","value":"{{paypalAuthAlgo}}"},{"key":"PAYPAL-CERT-URL","value":"{{paypalCertUrl}}"},{"key":"PAYPAL-TRANSMISSION-ID","value":"{{paypalTransmissionId}}"},{"key":"PAYPAL-TRANSMISSION-SIG","value":"{{paypalTransmissionSig}}"},{"key":"PAYPAL-TRANSMISSION-TIME","value":"{{paypalTransmissionTime}}"}],"body":{"mode":"raw","raw":"{\n  \"id\": \"{{paypalEventId}}\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {\n    \"id\": \"{{captureId}}\",\n    \"status\": \"COMPLETED\",\n    \"amount\": {\"value\": \"{{amount}}\", \"currency_code\": \"{{currency}}\"},\n    \"supplementary_data\": {\"related_ids\": {\"order_id\": \"{{orderId}}\"}}\n  }\n}"},"url":"{{baseUrl}}/api/paypal/webhooks"}}
  ]
}
